# Configuração local. Copie para .env.local; nunca publique valores reais.
APP_ORIGIN=http://localhost:3000
APP_TIMEZONE=America/Sao_Paulo

# Supabase Auth: login Google; pré-cadastrar dono e desativar cadastro público.
# Client ID/Secret Google ficam no painel Supabase, não neste arquivo.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
OWNER_USER_ID=

# Reservadas para a etapa de consultas/sync: papéis SQL distintos, somente servidor.
DATABASE_READ_URL=
DATABASE_SYNC_URL=
# Apenas ambiente de administração/migrações, nunca no runtime web.
DATABASE_MIGRATION_URL=

# Etapa posterior: Drive privado, conta de serviço leitora apenas da pasta fonte.
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# PEM com quebras de linha escapadas, inserido pelo gerenciador de segredos.
GOOGLE_PRIVATE_KEY=
SOURCE_SEASON=2026
SOURCE_FILENAME_PATTERN=^albuns_2026_mauricio_atualizado_v([0-9]+)_.+\.xlsx$

# Etapa posterior; manter vazios no MVP.
LASTFM_API_KEY=
LASTFM_USERNAME=
