# Configuração local. Copie para .env.local; nunca publique valores reais.
APP_ORIGIN=http://localhost:3000
APP_TIMEZONE=America/Sao_Paulo

# Supabase Auth: login Google; pré-cadastrar dono e desativar cadastro público.
# Client ID/Secret Google ficam no painel Supabase, não neste arquivo.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
OWNER_USER_ID=

# Papéis SQL distintos usados pelo backend; somente servidor.
DATABASE_READ_URL=
DATABASE_SYNC_URL=
# DATABASE_MIGRATION_URL fica somente em .env.migration.local, fora do runtime web.

# Sincronização manual: Drive privado, conta de serviço leitora apenas da pasta fonte.
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# PEM com quebras de linha escapadas, inserido pelo gerenciador de segredos.
GOOGLE_PRIVATE_KEY=
SOURCE_SEASON=2026

# Integração futura; manter vazios no MVP.
LASTFM_API_KEY=
LASTFM_USERNAME=
